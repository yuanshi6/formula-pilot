{
  "name": "formula-pilot",
  "version": "2.0.2",
  "description": "Guided LaTeX completion for Obsidian.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "yuanshi",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "package": "npm run build && node scripts/package-release.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test:run",
    "perf": "vitest run tests/performance.test.ts tests/ui-performance.test.ts --reporter=verbose",
    "vault:prepare": "node scripts/prepare-vault.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@codemirror/commands": "6.9.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "9.39.4",
    "@lezer/common": "1.5.2",
    "@types/node": "22.15.17",
    "@typescript-eslint/parser": "8.59.1",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.1",
    "jsdom": "29.1.1",
    "obsidian": "1.13.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.59.1",
    "vitest": "4.1.10"
  }
}
